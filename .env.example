# OpsEvalGate Provider Configuration
# Copy this file to .env and insert your actual keys:
#   cp .env.example .env

# LLM Provider Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default Model Selection (Optional)
DEFAULT_LIGHTWEIGHT_MODEL=gpt-4o-mini
DEFAULT_FRONTIER_MODEL=claude-3-5-sonnet-20241022

# Evaluation & Tracing Options (Optional)
OPSEVALGATE_ENV=development
ENABLE_REMOTE_OTEL=false